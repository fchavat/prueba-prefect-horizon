# Copy this file to .env and fill in your Google OAuth credentials.
#
# To obtain them:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID of type "Web application"
# 3. Add the authorized redirect URI: http://localhost:8000/auth/callback
#    (for production use https://your-domain.com/auth/callback)
# 4. Copy the Client ID and Client Secret here

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Public URL where the MCP server is reachable.
# For local development: http://localhost:8000
# For production / CogSol integration: https://your-domain.com
BASE_URL=http://localhost:8000

# Optional: comma-separated list of redirect URI patterns allowed for MCP clients.
# Required when integrating with web platforms like CogSol that do not use
# localhost callbacks. Patterns support wildcards.
# Example for CogSol:
# ALLOWED_CLIENT_REDIRECT_URIS="https://*.cogsol.com/oauth/callback"
ALLOWED_CLIENT_REDIRECT_URIS=
